# Build environment for an Athene-generated GTK4 application.
#
# Athene wrote this file once, when the project was created, and will never
# overwrite it — same as the Makefile and README.md, and unlike app.gen.go.
# Editing it is expected: adding a package your app needs at build time, or
# moving to a different base image, is exactly what it is here for.
#
# This image holds only the toolchain: the Go compiler plus the GTK4 development
# libraries that gotk4's cgo bindings compile against. Your project is *not*
# copied in — build-in-container.sh bind-mounts it at run time, so one image
# serves every Athene project on the machine and the source never gets baked
# into a layer.
#
# On the choice of base: a cgo binary links against the glibc and GTK it was
# compiled against, and then requires at least those versions wherever it runs,
# so an older base would widen the set of machines ./app starts on. Debian
# bookworm is as far back as one might like to go, but it cannot go there: its
# GLib 2.74 lacks symbols gotk4 references (g_path_buf_*, g_log_writer_syslog,
# g_date_time_new_from_unix_local_usec, …) and the build fails outright. GLib
# 2.80 or newer is required. Trixie is therefore the oldest Debian that works —
# see "Portability of the result" in README.md for what its glibc/GTK floor
# means for where the binary will run.
FROM docker.io/library/golang:1.24-trixie

# gotk4 asks pkg-config for gtk4, glib-2.0, pango and graphene; libgtk-4-dev
# depends on the -dev packages for all of those, so it covers all four.
#
# libgirepository1.0-dev is needed too, and less obviously: gotk4's core/gerror
# package has a cgo pkg-config line requiring gobject-introspection-1.0. That is
# a compile-time dependency of the bindings themselves — it is not there to
# *regenerate* them — and without it the build fails on the very first package
# with "Package 'gobject-introspection-1.0' ... not found".
#
# DEBIAN_FRONTEND is set for this RUN only, rather than as an image-wide ENV, so
# that a shell opened with './build-in-container.sh --shell' still gets the
# normal interactive apt. Without it, postinst scripts try (and loudly fail) to
# find a usable debconf frontend in a container with no tty. -qq keeps the
# package list to errors only; Acquire::Retries survives a flaky mirror instead
# of failing the build and making you pay for the whole image again.
RUN DEBIAN_FRONTEND=noninteractive apt-get -qq update \
    && DEBIAN_FRONTEND=noninteractive apt-get -qq install \
        --no-install-recommends --yes -o Acquire::Retries=3 \
        gcc pkg-config libgtk-4-dev libgirepository1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# The build runs as the invoking user, whose uid may not exist in this image and
# whose $HOME is not writable, so keep the Go caches somewhere explicit.
# build-in-container.sh bind-mounts both paths from a host cache directory —
# without that, every build recompiles the gotk4 cgo bindings from scratch, which
# takes minutes.
#
# -buildvcs=false: if the project happens to sit in a git working tree, 'go build'
# would otherwise shell out to git on every build to stamp the revision into the
# binary — and inside the container that git call is made by a uid that does not
# own the checkout, so git refuses it ("dubious ownership") and the build fails.
# Nothing here wants the stamp, so turn the whole step off.
ENV GOFLAGS="-mod=mod -buildvcs=false" \
    GOCACHE=/cache/go-build \
    GOMODCACHE=/cache/go-mod

WORKDIR /src
